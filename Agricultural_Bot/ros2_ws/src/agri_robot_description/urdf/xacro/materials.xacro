<?xml version="1.0"?>
<!-- Named colour values used by the audited URDF payload.  Keeping these in
     one module makes later visual/material overrides straightforward. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agri_robot_materials">
  <xacro:property name="chassis_rgba" value="0.16 0.24 0.32 1" />
  <xacro:property name="steer_rgba" value="0.28 0.52 0.78 1" />
  <xacro:property name="arm_rgba" value="0.22 0.48 0.78 1" />
  <xacro:property name="rubber_rgba" value="0.06 0.07 0.08 1" />
  <xacro:property name="gripper_rgba" value="0.95 0.48 0.10 1" />
  <xacro:property name="finger_rgba" value="0.78 0.80 0.84 1" />
  <xacro:property name="sensor_rgba" value="0.35 0.38 0.42 1" />
  <xacro:property name="basket_rgba" value="0.20 0.55 0.25 1" />
</robot>
