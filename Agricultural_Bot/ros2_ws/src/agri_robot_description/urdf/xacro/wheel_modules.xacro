<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="agri_wheel_modules">
    <link name="f1_steer_link">
        <!-- Provisional 15 kg mass properties from the centered steer mesh bounds. -->
        <inertial>
          <origin xyz="0 0.009266275 0.072000005" rpy="0 0 0"/>
          <mass value="15.0"/>
          <inertia ixx="0.2244577768" ixy="0" ixz="0" iyy="0.2240913810" iyz="0" izz="0.1893391739"/>
        </inertial>
        <visual>
          <origin xyz="0 -0.05 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://${mesh_package}/meshes/visual/f1_steer_link.STL"/>
          </geometry>
          <material name="steer_blue">
            <color rgba="${steer_rgba}"/>
          </material>
        </visual>
        <collision>
          <origin xyz="0 -0.05 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://${mesh_package}/meshes/visual/f1_steer_link.STL"/>
          </geometry>
        </collision>
      </link>
