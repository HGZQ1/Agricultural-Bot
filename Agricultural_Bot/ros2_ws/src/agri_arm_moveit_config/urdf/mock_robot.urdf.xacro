<?xml version="1.0"?>
<!-- Standalone, explicitly virtual backend. Geometry is always canonical. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agri_robot">
  <xacro:arg name="use_ros2_control" default="true"/>
  <xacro:include filename="$(find agri_robot_description)/urdf/agri_robot.urdf.xacro"/>
  <xacro:macro name="mock_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>
  <ros2_control name="ArmMockSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">true</param>
    </hardware>
    <xacro:mock_joint name="arm_joint1"/>
    <xacro:mock_joint name="arm_joint2"/>
    <xacro:mock_joint name="arm_joint3"/>
    <xacro:mock_joint name="arm_joint4"/>
    <xacro:mock_joint name="arm_joint5"/>
    <xacro:mock_joint name="cr5_joint6"/>
    <xacro:mock_joint name="gripper_left_finger_joint"/>
    <xacro:mock_joint name="gripper_right_finger_joint"/>
    <xacro:mock_joint name="f1_steer_joint"/>
    <xacro:mock_joint name="f2_steer_joint"/>
    <xacro:mock_joint name="r1_steer_joint"/>
    <xacro:mock_joint name="r2_steer_joint"/>
    <xacro:mock_joint name="f1_wheel_joint"/>
    <xacro:mock_joint name="f2_wheel_joint"/>
    <xacro:mock_joint name="r1_wheel_joint"/>
    <xacro:mock_joint name="r2_wheel_joint"/>
  </ros2_control>
</robot>
