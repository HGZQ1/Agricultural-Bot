<?xml version="1.0"?>
<package format="3">
  <name>agri_arm_control</name>
  <version>0.1.0</version>
  <description>Parked-station arm worker with bounded MoveIt and measured stow feedback.</description>
  <maintainer email="maintainer@example.com">Agricultural Bot Team</maintainer>
  <license>Apache-2.0</license>
