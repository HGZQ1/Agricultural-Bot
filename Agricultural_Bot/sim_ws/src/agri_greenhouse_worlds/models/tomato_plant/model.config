<?xml version="1.0"?>
<model>
  <name>tomato_plant</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>Abdurrahman Yilmaz; Agricultural Bot contributors</name>
