<?xml version="1.0"?>
<!-- Derived from LCAS/aoc_tomato_farm tomato_0 under Apache License 2.0.
     Keep the upstream mesh and texture assets in tomato_0. -->
<sdf version="1.6">
  <model name="tomato_plant">
    <static>true</static>
    <link name="link">
      <collision name="stem">
        <pose>0 0 0.6208 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.1 1.2416</size>
          </box>
        </geometry>
      </collision>
      <visual name="branch">
        <geometry>
          <mesh>
            <uri>model://tomato_0/meshes/tomato.dae</uri>
            <submesh><name>Branch1</name></submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <script>
            <uri>model://tomato_0/materials/scripts/</uri>
            <uri>model://tomato_0/materials/textures/</uri>
            <name>branch</name>
          </script>
          <pbr><metal>
            <albedo_map>model://tomato_0/materials/textures/AG15brn1.png</albedo_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="leaf1">
        <geometry>
          <mesh>
            <uri>model://tomato_0/meshes/tomato.dae</uri>
            <submesh><name>Leaf1</name></submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <script>
            <uri>model://tomato_0/materials/scripts/</uri>
            <uri>model://tomato_0/materials/textures/</uri>
            <name>leaf1</name>
          </script>
          <pbr><metal>
            <albedo_map>model://tomato_0/materials/textures/AG15lef1.png</albedo_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="leaf2">
        <geometry>
          <mesh>
            <uri>model://tomato_0/meshes/tomato.dae</uri>
            <submesh><name>Leaf2</name></submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <script>
            <uri>model://tomato_0/materials/scripts/</uri>
            <uri>model://tomato_0/materials/textures/</uri>
            <name>leaf2</name>
          </script>
          <pbr><metal>
            <albedo_map>model://tomato_0/materials/textures/AG15lef2.png</albedo_map>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
