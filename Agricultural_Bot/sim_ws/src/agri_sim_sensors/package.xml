<?xml version="1.0"?>
<package format="3">
  <name>agri_sim_sensors</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic MID-360 and aligned D405 RGB-D sensor simulation.</description>
  <maintainer email="maintainer@example.com">Agricultural Bot Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
