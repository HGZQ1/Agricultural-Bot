<?xml version="1.0"?>
<!-- Gazebo Harmonic entry point. The canonical robot remains owned by
     agri_robot_description; this file only adds simulation-specific control. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agri_robot">
  <xacro:arg name="use_control" default="false" />
  <xacro:arg name="use_ros2_control" default="$(arg use_control)" />
  <xacro:arg name="controller_config" default="" />
  <xacro:arg name="use_lidar" default="true" />
  <xacro:arg name="lidar_mode" default="gpu_lidar" />
  <xacro:arg name="mid360_frame" default="mid360_sensor_frame" />
  <xacro:arg name="mid360_topic" default="/mid360" />
  <xacro:arg name="mid360_rate" default="10.0" />
  <xacro:arg name="mid360_min_range" default="0.1" />
  <xacro:arg name="mid360_max_range" default="40.0" />
  <xacro:arg name="mid360_h_samples" default="1875" />
  <xacro:arg name="mid360_v_samples" default="32" />
  <xacro:arg name="mid360_h_min" default="-3.141592653589793" />
  <xacro:arg name="mid360_h_max" default="3.141592653589793" />
  <xacro:arg name="mid360_v_min" default="-0.12217304763960307" />
  <xacro:arg name="mid360_v_max" default="0.9075712110370514" />
  <xacro:arg name="mid360_resolution" default="0.01" />
  <xacro:arg name="mid360_noise" default="0.005" />
  <xacro:arg name="mid360_visualize" default="true" />
  <xacro:arg name="mid360_preset" default="Livox Mid360" />
  <xacro:arg name="use_camera" default="true" />
  <xacro:arg name="d405_frame" default="d405_sensor_frame" />
  <xacro:arg name="d405_optical_frame" default="camera_optical_frame" />
  <xacro:arg name="d405_topic" default="/d405" />
  <xacro:arg name="d405_width" default="848" />
  <xacro:arg name="d405_height" default="480" />
  <xacro:arg name="d405_rate" default="30.0" />
  <xacro:arg name="d405_hfov" default="1.5184364492350666" />
  <xacro:arg name="d405_fx" default="446.802773119128" />
  <xacro:arg name="d405_fy" default="432.971461265142" />
  <xacro:arg name="d405_cx" default="424" />
  <xacro:arg name="d405_cy" default="240" />
  <xacro:arg name="d405_color_near" default="0.01" />
  <xacro:arg name="d405_color_far" default="10.0" />
  <xacro:arg name="d405_depth_near" default="0.07" />
  <xacro:arg name="d405_depth_far" default="0.5" />

  <xacro:include filename="$(find agri_robot_description)/urdf/agri_robot.urdf.xacro" />
  <xacro:include filename="$(find agri_sim_sensors)/urdf/mid360.gazebo.xacro" />
  <xacro:include filename="$(find agri_sim_sensors)/urdf/d405.gazebo.xacro" />
  <xacro:if value="$(arg use_lidar)">
    <xacro:agri_mid360_simulation
      mode="$(arg lidar_mode)" frame_id="$(arg mid360_frame)" topic="$(arg mid360_topic)"
      rate="$(arg mid360_rate)" min_range="$(arg mid360_min_range)" max_range="$(arg mid360_max_range)"
      h_samples="$(arg mid360_h_samples)" v_samples="$(arg mid360_v_samples)"
      h_min="$(arg mid360_h_min)" h_max="$(arg mid360_h_max)"
      v_min="$(arg mid360_v_min)" v_max="$(arg mid360_v_max)"
      resolution="$(arg mid360_resolution)" noise="$(arg mid360_noise)"
      visualize="$(arg mid360_visualize)" preset="$(arg mid360_preset)" />
  </xacro:if>

  <xacro:if value="$(arg use_camera)">
    <xacro:agri_d405_simulation
      frame_id="$(arg d405_frame)" optical_frame="$(arg d405_optical_frame)"
      topic="$(arg d405_topic)" width="$(arg d405_width)" height="$(arg d405_height)"
      rate="$(arg d405_rate)" hfov="$(arg d405_hfov)"
      fx="$(arg d405_fx)" fy="$(arg d405_fy)" cx="$(arg d405_cx)" cy="$(arg d405_cy)"
      color_near="$(arg d405_color_near)" color_far="$(arg d405_color_far)"
      depth_near="$(arg d405_depth_near)" depth_far="$(arg d405_depth_far)" />
  </xacro:if>

  <xacro:if value="$(arg use_control)">
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="f1_steer_joint">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="f2_steer_joint">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="r1_steer_joint">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="r2_steer_joint">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>

      <joint name="f1_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="f2_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="r1_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="r2_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>

      <joint name="arm_joint1">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="arm_joint2">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="arm_joint3">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="arm_joint4">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="arm_joint5">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="cr5_joint6">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>

      <!-- DART does not enforce the URDF mimic constraint. Both finger joints
           therefore expose an independent command interface. -->
      <joint name="gripper_left_finger_joint">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="gripper_right_finger_joint" mimic="false">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
    </ros2_control>

    <gazebo>
      <plugin
        filename="libgz_ros2_control-system.so"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controller_config)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
