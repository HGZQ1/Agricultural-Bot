  <version>0.1.0</version>
  <description>Gazebo Harmonic overlay for the Agricultural_Bot description.</description>
  <maintainer email="maintainer@example.com">Agricultural Bot Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
